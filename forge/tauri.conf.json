{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POP Forge",
  "version": "0.3.13",
  "identifier": "app.pop.forge",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "POP Forge : l'atelier de bureau de POP pour UEFN",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "French"
        ],
        "installerIcon": "icons/icon.ico",
        "headerImage": "installateur/header.bmp",
        "sidebarImage": "installateur/sidebar.bmp",
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true,
    "publisher": "POP",
    "copyright": "POP"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "pop-forge"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDgxQjg0NUU4OTM2N0Q5NjUKUldSbDJXZVQ2RVc0Z1JFVWZnVjRxSG5iMHQvWUFrZGhrTGJkbFZNeEg4L0d6bWRKek9CUUxPaWwK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
