#!/bin/sh
# Garde-fou des branches de POP (AGENTS.md §4.5), activé par « python tools/task.py whoami »
# (git config core.hooksPath tools/hooks). Refuse :
#   - tout push vers main : rien n'arrive sur main sans PR, c'est « task.py done » qui fusionne ;
#   - une branche dont le nom n'est ni issue/N-… ni outillage/….
# Supprimer une branche distante reste permis. Ne le contournez jamais (--no-verify) : demandez à votre humain.

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
    branch=${remote_ref#refs/heads/}
    case "$local_sha" in *[!0]*) ;; *) continue ;; esac   # suppression d'une branche distante
    case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac   # étiquettes et autres références
    if [ "$branch" = main ] || [ "$branch" = master ]; then
        echo "REFUSÉ (pre-push) : on ne pousse jamais sur $branch. Poussez votre branche issue/N-… et passez par" >&2
        echo "  « python tools/task.py review N » ; la fusion se fait par « task.py done » (AGENTS.md §4.5)." >&2
        status=1
        continue
    fi
    if ! printf '%s\n' "$branch" | grep -Eq '^(issue/[0-9]+-[a-z0-9-]+|outillage/[a-z0-9][a-z0-9-]*)$'; then
        echo "REFUSÉ (pre-push) : « $branch » n'est pas un nom de branche permis." >&2
        echo "  Une tâche : issue/N-… (créée par « task.py start N »). Outillage ou documentation : outillage/…" >&2
        echo "  Renommez : git branch -m issue/N-sujet   (AGENTS.md §4.5)" >&2
        status=1
    fi
done
exit $status
