# HTTPS automatique pour POP. Le domaine vient de POP_DOMAIN (fichier .env).
# Le DNS du domaine doit pointer vers le serveur AVANT le premier démarrage, sinon Let's Encrypt échoue.
{$POP_DOMAIN} {
	encode zstd gzip
	# Les WebSocket (temps réel, Yjs) passent sans réglage particulier.
	reverse_proxy pop:8080
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}

# www.<domaine> renvoie vers le domaine principal (même certificat automatique).
# Son DNS doit aussi pointer vers le serveur ; sinon Caddy le signale dans ses journaux, sans gêner le domaine principal.
www.{$POP_DOMAIN} {
	redir https://{$POP_DOMAIN}{uri} permanent
}
