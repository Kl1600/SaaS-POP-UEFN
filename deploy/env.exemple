# Modèle du fichier .env du serveur. Sur le serveur : cp env.exemple .env && nano .env && chmod 600 .env
# Ne jamais commiter le vrai .env : il contient des mots de passe.

# Domaine de POP (son DNS doit pointer vers l'adresse IP du serveur).
# Sans domaine, pour tester : <ip-avec-des-tirets>.sslip.io (ex. 203-0-113-7.sslip.io), certificat HTTPS compris.
# Changer de domaine plus tard oblige à reconfigurer pop-link et à se reconnecter : prendre le vrai avant les clients.
POP_DOMAIN=pop.exemple.com

# Image à lancer. Par défaut la dernière de main ; pour revenir en arrière : ghcr.io/kl1600/saas-pop-uefn:sha-<7 caractères>
#POP_IMAGE=ghcr.io/kl1600/saas-pop-uefn:latest

# Administrateurs de la plateforme (e-mails séparés par des virgules).
POP_ADMIN_EMAILS=

# 1 = inscriptions ouvertes à tous ; 0 = liste d'attente validée dans Administration.
POP_OPEN_SIGNUP=0

# Collecte des statistiques publiques Epic (1 = oui, 0 = non).
POP_ANALYTICS=1

# E-mails (invitations, mot de passe oublié). Port 587 : Hetzner bloque 25 et 465 sur les nouveaux comptes.
POP_SMTP_HOST=
POP_SMTP_PORT=587
POP_SMTP_USER=
POP_SMTP_PASS=
POP_SMTP_FROM=

# Sauvegarde continue de la base (Litestream). Décommenter COMPOSE_PROFILES une fois le stockage créé.
#COMPOSE_PROFILES=sauvegarde
# Cloudflare R2 : endpoint https://<id-du-compte>.r2.cloudflarestorage.com, région auto
# Backblaze B2  : endpoint https://s3.<région>.backblazeb2.com, région <région> (ex. eu-central-003)
LITESTREAM_BUCKET=
LITESTREAM_ENDPOINT=
LITESTREAM_REGION=auto
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
